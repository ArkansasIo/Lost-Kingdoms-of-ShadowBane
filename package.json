{
  "name": "gb-quest",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js tests/**/*.test.js",
    "test:unreal-reference": "node --test unreal/GBQuestUE5/SourceReference/GBQuest/tests/*.test.js unreal/GBQuestUE5/SourceReference/GBQuest/tests/**/*.test.js",
    "sweep": "python3 tests/sweep.py",
    "native:build": "cmake -S native -B build/native -DGBQ_ENABLE_X86_64_ASM=OFF && cmake --build build/native --config Release",
    "start": "node server.js",
    "server": "node backend/server.cjs",
    "desktop:dev": "electron .",
    "desktop:dist": "electron-builder",
    "admin": "node backend/admin-cli.cjs",
    "build:itch": "node tools/build-itch.cjs",
    "sql": "node tools/export_sql.cjs"
  },
  "main": "desktop/main.cjs",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.1"
  },
  "build": {
    "appId": "io.arkansasio.gbquest",
    "productName": "Lost Kingdom of Shadowbane Chronicles",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/launcher.html",
      "dist/gbquest-fullscreen.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
